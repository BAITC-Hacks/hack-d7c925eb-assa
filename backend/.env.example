# Server-only settings. Keep the real .env outside version control.
CQ_MODE=demo
# External processing is OFF until the dataset owner permits the chosen provider.
CQ_ALLOW_EXTERNAL_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# For a protected local pilot: CQ_MODE=private. Use independent random codes >=16 chars.
# Demo profile/role switching is disabled in private mode.
CQ_EMPLOYEE_ACCESS_CODE=
CQ_HR_ACCESS_CODE=
CQ_EMPLOYEE_ID=E0001
# Scope the HR account to one actual department from the dataset.
CQ_HR_DEPARTMENT=
